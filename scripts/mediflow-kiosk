#!/usr/bin/env python3
"""Manage the MediFlow kiosk processes without systemd or broad PID matching."""

from __future__ import annotations

import collections
import dataclasses
import datetime as dt
import fcntl
import json
import os
import signal
import shlex
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any, Iterable, Mapping, Sequence


SCRIPT_PATH = Path(__file__).resolve()
PROJECT_DIR = SCRIPT_PATH.parent.parent
COMMAND_NAME = "mediflow-kiosk"
PROJECT_NAME = "MediFlow Kiosk"
RUNTIME_DIR = PROJECT_DIR / "runtime"
RUN_DIR = RUNTIME_DIR / "run"
LOG_DIR = RUNTIME_DIR / "log"
LOCK_PATH = RUN_DIR / f"{COMMAND_NAME}.lock"
ALLOWED_ACTIONS = frozenset({"start", "stop", "restart", "status", "logs"})
LOG_LINE_LIMIT = 80
START_TIMEOUT_SECONDS = 90.0
STOP_TIMEOUT_SECONDS = 12.0
KILL_TIMEOUT_SECONDS = 3.0
PORT_RELEASE_TIMEOUT_SECONDS = 5.0


def read_env_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    for raw_line in path.read_text(encoding="utf-8-sig").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export ") :].lstrip()
        if "=" not in line:
            continue
        key, raw_value = line.split("=", 1)
        key = key.strip()
        if not key or not key.replace("_", "").isalnum():
            continue
        try:
            parsed = shlex.split(raw_value, comments=True, posix=True)
        except ValueError:
            continue
        values[key] = " ".join(parsed) if parsed else ""
    return values


PROJECT_ENV = read_env_file(PROJECT_DIR / ".env")


def setting(name: str, default: str) -> str:
    value = os.environ.get(name)
    if value is None:
        value = PROJECT_ENV.get(name, default)
    value = str(value).strip()
    return value if value else default


def setting_port(name: str, default: int) -> int:
    raw_value = setting(name, str(default))
    try:
        port = int(raw_value)
    except ValueError as exc:
        raise ManagerError(f"{name} must be an integer, got {raw_value!r}") from exc
    if not 1 <= port <= 65535:
        raise ManagerError(f"{name} must be between 1 and 65535, got {port}")
    return port


def get_lan_ip() -> str | None:
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
            probe.connect(("8.8.8.8", 80))
            address = probe.getsockname()[0]
        return address if address and not address.startswith("127.") else None
    except OSError:
        return None


def resolve_dashboard_url() -> str:
    external_url = setting("EXTERNAL_BASE_URL", "")
    if external_url:
        parsed = urllib.parse.urlsplit(external_url)
        if parsed.scheme in {"http", "https"} and parsed.netloc and not parsed.username:
            return external_url.rstrip("/")

    port = setting_port("SERVER_PORT", 5000)
    host = setting("SERVER_IP", setting("SERVER_HOST", "0.0.0.0"))
    if host in {"0.0.0.0", "::", "[::]"}:
        host = get_lan_ip() or "127.0.0.1"
    return f"http://{host}:{port}"


class ManagerError(RuntimeError):
    """Raised when a requested manager action cannot be completed safely."""


class UsageError(ManagerError):
    """Raised for unsupported or ambiguous command-line input."""


@dataclasses.dataclass(frozen=True)
class ServiceSpec:
    key: str
    label: str
    launch_argv: tuple[str, ...]
    executable: str
    cwd: str
    port: int
    health_url: str
    environment: Mapping[str, str] = dataclasses.field(default_factory=dict)

    @property
    def pid_path(self) -> Path:
        return RUN_DIR / f"{COMMAND_NAME}.{self.key}.pid"

    @property
    def log_path(self) -> Path:
        return LOG_DIR / f"{self.key}.log"


@dataclasses.dataclass(frozen=True)
class ProcessSnapshot:
    pid: int
    uid: int
    executable: str
    argv: tuple[str, ...]
    cwd: str
    state: str
    start_ticks: int
    boot_id: str


def parse_action(argv: Sequence[str]) -> str:
    if len(argv) != 2 or argv[1] not in ALLOWED_ACTIONS:
        allowed = "|".join(sorted(ALLOWED_ACTIONS))
        raise UsageError(f"usage: {COMMAND_NAME} <{allowed}>")
    return argv[1]


def ensure_execution_user() -> None:
    project_uid = PROJECT_DIR.stat().st_uid
    if os.getuid() != project_uid:
        raise ManagerError(
            f"run this command as the project owner (uid={project_uid}), not uid={os.getuid()}"
        )


def ensure_runtime_dirs() -> None:
    for path in (RUNTIME_DIR, RUN_DIR, LOG_DIR):
        path.mkdir(parents=True, exist_ok=True)
        os.chmod(path, 0o700)


def resolve_python() -> Path:
    for candidate in (PROJECT_DIR / "venv" / "bin" / "python", PROJECT_DIR / ".venv" / "bin" / "python"):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    raise ManagerError(f"Python virtual environment not found under {PROJECT_DIR}")


def service_specs() -> tuple[ServiceSpec, ...]:
    python_path = resolve_python()
    executable = str(python_path.resolve())
    cwd = str(PROJECT_DIR)
    server_port = setting_port("SERVER_PORT", 5000)
    kakao_port = setting_port("KAKAO_APP_PORT", 5001)
    return (
        ServiceSpec(
            key="eye_server",
            label="eye_server",
            launch_argv=(str(python_path), str(PROJECT_DIR / "eye_server.py")),
            executable=executable,
            cwd=cwd,
            port=server_port,
            health_url=f"http://127.0.0.1:{server_port}/status",
        ),
        ServiceSpec(
            key="kakao_app",
            label="kakao_app",
            launch_argv=(str(python_path), str(PROJECT_DIR / "database" / "app.py")),
            executable=executable,
            cwd=cwd,
            port=kakao_port,
            health_url=f"http://127.0.0.1:{kakao_port}/health",
            environment={"KAKAO_APP_PORT": str(kakao_port)},
        ),
    )


def read_boot_id() -> str:
    return Path("/proc/sys/kernel/random/boot_id").read_text(encoding="ascii").strip()


def read_process_snapshot(pid: int) -> ProcessSnapshot | None:
    proc_dir = Path("/proc") / str(pid)
    try:
        stat_text = (proc_dir / "stat").read_text(encoding="utf-8")
        closing_paren = stat_text.rfind(")")
        if closing_paren < 0:
            return None
        fields = stat_text[closing_paren + 2 :].split()
        state = fields[0]
        start_ticks = int(fields[19])
        if state == "Z":
            return None

        uid = -1
        for line in (proc_dir / "status").read_text(encoding="utf-8").splitlines():
            if line.startswith("Uid:"):
                uid = int(line.split()[1])
                break
        if uid < 0:
            return None

        argv_bytes = (proc_dir / "cmdline").read_bytes().split(b"\0")
        argv = tuple(item.decode("utf-8", "surrogateescape") for item in argv_bytes if item)
        return ProcessSnapshot(
            pid=pid,
            uid=uid,
            executable=str((proc_dir / "exe").resolve(strict=True)),
            argv=argv,
            cwd=str((proc_dir / "cwd").resolve(strict=True)),
            state=state,
            start_ticks=start_ticks,
            boot_id=read_boot_id(),
        )
    except (FileNotFoundError, PermissionError, ProcessLookupError, ValueError, IndexError):
        return None


def snapshot_matches_spec(snapshot: ProcessSnapshot, spec: ServiceSpec) -> bool:
    return (
        snapshot.uid == os.getuid()
        and snapshot.executable == spec.executable
        and snapshot.argv == spec.launch_argv
        and snapshot.cwd == spec.cwd
    )


def build_process_record(spec: ServiceSpec, pid: int) -> dict[str, Any]:
    deadline = time.monotonic() + 2.0
    snapshot: ProcessSnapshot | None = None
    while time.monotonic() < deadline:
        snapshot = read_process_snapshot(pid)
        if snapshot is not None and snapshot_matches_spec(snapshot, spec):
            break
        time.sleep(0.05)
    if snapshot is None or not snapshot_matches_spec(snapshot, spec):
        raise ManagerError(f"{spec.label} did not start with the expected process identity")

    return {
        "version": 1,
        "service": spec.key,
        "pid": snapshot.pid,
        "uid": snapshot.uid,
        "executable": snapshot.executable,
        "argv": list(snapshot.argv),
        "cwd": snapshot.cwd,
        "start_ticks": snapshot.start_ticks,
        "boot_id": snapshot.boot_id,
        "started_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
    }


def write_record(path: Path, record: Mapping[str, Any]) -> None:
    temporary = path.with_suffix(path.suffix + ".tmp")
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    descriptor = os.open(temporary, flags, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(record, handle, ensure_ascii=True, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
    except Exception:
        temporary.unlink(missing_ok=True)
        raise
    os.replace(temporary, path)
    os.chmod(path, 0o600)


def load_record(path: Path) -> dict[str, Any] | None:
    if not path.exists():
        return None
    metadata = path.stat()
    if metadata.st_uid != os.getuid() or metadata.st_mode & 0o022:
        raise ManagerError(f"unsafe PID metadata permissions: {path}")
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ManagerError(f"invalid PID metadata: {path}: {exc}") from exc
    if not isinstance(payload, dict):
        raise ManagerError(f"invalid PID metadata object: {path}")
    return payload


def validate_record(
    spec: ServiceSpec, record: Mapping[str, Any]
) -> tuple[bool, str, ProcessSnapshot | None]:
    try:
        pid = int(record["pid"])
        expected = {
            "version": 1,
            "service": spec.key,
            "uid": os.getuid(),
            "executable": spec.executable,
            "argv": list(spec.launch_argv),
            "cwd": spec.cwd,
            "boot_id": read_boot_id(),
        }
        for key, value in expected.items():
            if record.get(key) != value:
                return False, f"metadata mismatch: {key}", read_process_snapshot(pid)
        start_ticks = int(record["start_ticks"])
    except (KeyError, TypeError, ValueError) as exc:
        return False, f"invalid metadata fields: {exc}", None

    snapshot = read_process_snapshot(pid)
    if snapshot is None:
        return False, "process is not running", None
    if snapshot.start_ticks != start_ticks:
        return False, "PID was reused", snapshot
    if not snapshot_matches_spec(snapshot, spec):
        return False, "live process identity mismatch", snapshot
    return True, "running", snapshot


def inspect_service(
    spec: ServiceSpec, *, remove_stale: bool = False
) -> tuple[str, dict[str, Any] | None, ProcessSnapshot | None]:
    record = load_record(spec.pid_path)
    if record is None:
        return "unmanaged-port" if port_is_open(spec.port) else "stopped", None, None

    valid, reason, snapshot = validate_record(spec, record)
    if valid:
        return "running", record, snapshot
    if snapshot is None and remove_stale:
        spec.pid_path.unlink(missing_ok=True)
        return "stopped", None, None
    return f"invalid:{reason}", record, snapshot


def port_is_open(port: int) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.25):
            return True
    except OSError:
        return False


def health_is_ready(url: str) -> bool:
    try:
        request = urllib.request.Request(url, method="GET")
        with urllib.request.urlopen(request, timeout=1.5) as response:
            return 200 <= int(response.status) < 300
    except (OSError, urllib.error.URLError, TimeoutError):
        return False


def open_log(path: Path):
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    os.chmod(path, 0o600)
    return os.fdopen(descriptor, "a", encoding="utf-8", buffering=1)


def spawn_service(spec: ServiceSpec) -> tuple[subprocess.Popen[bytes], dict[str, Any]]:
    if port_is_open(spec.port):
        raise ManagerError(
            f"refusing to start {spec.label}: port {spec.port} is used by an unmanaged process"
        )

    environment = os.environ.copy()
    environment.update(spec.environment)
    environment["PYTHONUNBUFFERED"] = "1"
    timestamp = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")

    with open_log(spec.log_path) as log_handle:
        log_handle.write(f"\n[{timestamp}] {COMMAND_NAME} starting {spec.label}\n")
        process = subprocess.Popen(
            list(spec.launch_argv),
            cwd=spec.cwd,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            close_fds=True,
            start_new_session=True,
        )

    try:
        record = build_process_record(spec, process.pid)
        write_record(spec.pid_path, record)
        return process, record
    except Exception:
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=2.0)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=2.0)
        raise


def wait_for_services(
    services: Iterable[tuple[ServiceSpec, Mapping[str, Any]]], timeout: float
) -> None:
    pending = {spec.key: (spec, record) for spec, record in services}
    deadline = time.monotonic() + timeout
    while pending and time.monotonic() < deadline:
        for key, (spec, record) in list(pending.items()):
            valid, reason, _ = validate_record(spec, record)
            if not valid:
                raise ManagerError(f"{spec.label} exited during startup: {reason}")
            if health_is_ready(spec.health_url):
                del pending[key]
        if pending:
            time.sleep(0.5)
    if pending:
        labels = ", ".join(spec.label for spec, _ in pending.values())
        raise ManagerError(f"startup health check timed out: {labels}")


def terminate_record(spec: ServiceSpec, record: Mapping[str, Any]) -> None:
    valid, reason, snapshot = validate_record(spec, record)
    if not valid:
        if snapshot is None:
            spec.pid_path.unlink(missing_ok=True)
            return
        raise ManagerError(f"refusing to stop {spec.label}: {reason}")

    assert snapshot is not None
    os.kill(snapshot.pid, signal.SIGTERM)
    deadline = time.monotonic() + STOP_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        valid, _, _ = validate_record(spec, record)
        if not valid:
            spec.pid_path.unlink(missing_ok=True)
            return
        time.sleep(0.2)

    valid, reason, snapshot = validate_record(spec, record)
    if valid and snapshot is not None:
        os.kill(snapshot.pid, signal.SIGKILL)
        deadline = time.monotonic() + KILL_TIMEOUT_SECONDS
        while time.monotonic() < deadline:
            valid, _, _ = validate_record(spec, record)
            if not valid:
                spec.pid_path.unlink(missing_ok=True)
                return
            time.sleep(0.1)
    raise ManagerError(f"failed to stop {spec.label}: {reason}")


def start_all(specs: Sequence[ServiceSpec]) -> dict[str, dict[str, Any]]:
    records: dict[str, dict[str, Any]] = {}
    started: list[tuple[ServiceSpec, dict[str, Any]]] = []
    try:
        for spec in specs:
            state, record, _ = inspect_service(spec, remove_stale=True)
            if state == "running" and record is not None:
                records[spec.key] = record
                continue
            if state != "stopped":
                raise ManagerError(f"refusing to start {spec.label}: {state}")
            _, record = spawn_service(spec)
            records[spec.key] = record
            started.append((spec, record))

        wait_for_services(((spec, records[spec.key]) for spec in specs), START_TIMEOUT_SECONDS)
    except Exception:
        for spec, record in reversed(started):
            try:
                terminate_record(spec, record)
            except ManagerError:
                pass
        raise

    print(f"[{PROJECT_NAME}] service started")
    print(f"[{PROJECT_NAME}] URL: {resolve_dashboard_url()}")
    return records


def stop_all(specs: Sequence[ServiceSpec]) -> None:
    errors: list[str] = []
    for spec in reversed(specs):
        try:
            state, record, _ = inspect_service(spec, remove_stale=True)
            if state == "running" and record is not None:
                terminate_record(spec, record)
            elif state.startswith("invalid:") or state == "unmanaged-port":
                errors.append(f"{spec.label}: {state}")
        except ManagerError as exc:
            errors.append(str(exc))

    deadline = time.monotonic() + PORT_RELEASE_TIMEOUT_SECONDS
    while time.monotonic() < deadline and any(port_is_open(spec.port) for spec in specs):
        time.sleep(0.1)

    for spec in specs:
        if port_is_open(spec.port):
            errors.append(f"{spec.label}: port {spec.port} is still open")

    if errors:
        raise ManagerError("; ".join(errors))
    print(f"[{PROJECT_NAME}] service stopped")


def restart_all(specs: Sequence[ServiceSpec]) -> None:
    old_identity: dict[str, tuple[int, int]] = {}
    for spec in specs:
        state, record, snapshot = inspect_service(spec, remove_stale=True)
        if state == "running" and record is not None and snapshot is not None:
            old_identity[spec.key] = (snapshot.pid, snapshot.start_ticks)
        elif state not in {"stopped"}:
            raise ManagerError(f"refusing to restart {spec.label}: {state}")

    stop_all(specs)
    new_records = start_all(specs)
    for spec in specs:
        old = old_identity.get(spec.key)
        if old is None:
            continue
        new = (int(new_records[spec.key]["pid"]), int(new_records[spec.key]["start_ticks"]))
        if new == old:
            raise ManagerError(f"restart did not replace {spec.label} process identity")


def print_status(specs: Sequence[ServiceSpec]) -> None:
    states: list[str] = []
    for spec in specs:
        state, record, snapshot = inspect_service(spec, remove_stale=True)
        states.append(state)
        if state == "running" and record is not None and snapshot is not None:
            port_state = "open" if port_is_open(spec.port) else "closed"
            print(
                f"{spec.label}: running | PID={snapshot.pid} | port={spec.port} ({port_state}) "
                f"| started={record.get('started_at', 'unknown')}"
            )
        elif state == "unmanaged-port":
            print(f"{spec.label}: unmanaged process detected on port {spec.port}")
        else:
            print(f"{spec.label}: {state} | port={spec.port}")

    if all(state == "running" for state in states):
        overall = "running"
    elif all(state == "stopped" for state in states):
        overall = "stopped"
    else:
        overall = "degraded"
    print(f"[{PROJECT_NAME}] status: {overall}")
    print(f"[{PROJECT_NAME}] URL: {resolve_dashboard_url()}")


def tail_lines(path: Path, limit: int = LOG_LINE_LIMIT) -> list[str]:
    if not path.exists():
        return []
    with path.open("r", encoding="utf-8", errors="replace") as handle:
        return list(collections.deque(handle, maxlen=limit))


def print_logs(specs: Sequence[ServiceSpec]) -> None:
    for index, spec in enumerate(specs):
        if index:
            print()
        print(f"== {spec.label}: {spec.log_path} (last {LOG_LINE_LIMIT} lines) ==")
        lines = tail_lines(spec.log_path)
        if lines:
            for line in lines:
                print(line, end="" if line.endswith("\n") else "\n")
        else:
            print("(no log entries)")


def run_locked(action: str, specs: Sequence[ServiceSpec]) -> None:
    descriptor = os.open(LOCK_PATH, os.O_RDWR | os.O_CREAT, 0o600)
    os.chmod(LOCK_PATH, 0o600)
    with os.fdopen(descriptor, "r+") as lock_handle:
        try:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ManagerError(f"another {COMMAND_NAME} action is already running") from exc

        if action == "start":
            start_all(specs)
        elif action == "stop":
            stop_all(specs)
        elif action == "restart":
            restart_all(specs)
        elif action == "status":
            print_status(specs)
        elif action == "logs":
            print_logs(specs)
        else:
            raise AssertionError(f"unsupported action: {action}")


def main(argv: Sequence[str] | None = None) -> int:
    try:
        action = parse_action(sys.argv if argv is None else argv)
        ensure_execution_user()
        ensure_runtime_dirs()
        run_locked(action, service_specs())
        return 0
    except UsageError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    except ManagerError as exc:
        print(f"[{PROJECT_NAME}] error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
